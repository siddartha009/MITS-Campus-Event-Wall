rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /posters/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /recaps/{eventId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
